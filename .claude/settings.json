{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-animation-skill": {
      "source": {
        "source": "github",
        "repo": "buildwithhanif/claude-animation-skill"
      }
    }
  },
  "enabledPlugins": {
    "claude-animation@claude-animation-skill": true
  },
  "env": {
    "HYPERFRAMES_NO_TELEMETRY": "1",
    "DO_NOT_TRACK": "1"
  }
}
